# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: sync slash commands to a single guild instantly while developing
# DEV_GUILD_ID=123456789012345678

# Optional: sample desktop/mobile/web (also enable Presence Intent in the portal)
# PRESENCE_INTENT=true

# Optional: timezone for the 3:00 AM daily analytics post (IANA name)
# REPORT_TZ=America/New_York

# Voice transcription (busiest VC, consent reactions). Set false to disable.
# VOICE_LISTEN=true
# WHISPER_MODEL=base.en

# SQLite path. Docker compose mounts ./data at /data.
DATABASE_PATH=data/shadowmarket.db
